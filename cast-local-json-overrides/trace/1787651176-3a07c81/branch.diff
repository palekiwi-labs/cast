+    fn load_with_project_files(
+        project: Option<&str>,
+        local: Option<&str>,
+        mcp: Option<&str>,
+    ) -> Result<Config> {
+        let dir = tempfile::tempdir().unwrap();
+        for (name, body) in [
+            ("cast.json", project),
+            ("cast.local.json", local),
+            ("cast-mcp.json", mcp),
+        ] {
+            if let Some(body) = body {
+                std::fs::write(dir.path().join(name), body).unwrap();
+            }
+        }
+
+        load_config_with_global(dir.path(), None)
+    }
+
