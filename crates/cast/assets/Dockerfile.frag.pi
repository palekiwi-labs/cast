# --- pi ---
ARG PI_VERSION=latest
RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) BIN_ARCH="x64" ;; \
        arm64) BIN_ARCH="arm64" ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/badlogic/pi-mono/releases/download/v${PI_VERSION}/pi-linux-${BIN_ARCH}.tar.gz" \
    | tar -xz -C /opt/; \
    ln -s /opt/pi/pi /usr/local/bin/pi; \
    chmod +x /usr/local/bin/pi;
