FROM debian:trixie-slim

ARG TARGETARCH

# Install essential tools for development (union of all agents' deps).
# No harness binaries are baked in — harnesses are provided by the sandbox
# Nix devShell selected at run time.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    ssh \
    && rm -rf /var/lib/apt/lists/*

# Configure Nix system-wide: enable flakes only. `accept-flake-config = false`
# is explicit: under the hardened nix daemon (trusted-users = root) the dev
# user is non-trusted, so flake-forwarded substituters/keys are rejected
# anyway. Setting it false deterministically suppresses the interactive prompt
# path. Binary caches (e.g. cache.numtide.com) are provisioned daemon-side via
# ~/.config/cast/cast.json (created by `cast config init`) -> generate_nix_conf.
# (Nix store itself is mounted read-only from the nix-daemon volume.)
RUN mkdir -p /etc/nix && \
    printf 'experimental-features = nix-command flakes\naccept-flake-config = false\n' \
        > /etc/nix/nix.conf

# Add Nix to PATH (available once /nix is mounted)
ENV PATH="/nix/var/nix/profiles/default/bin:${PATH}"

# Limit GC marker threads for Nix commands running in the container
ENV GC_NPROCS=1

# Ensure Nix client communicates via daemon socket (store is mounted read-only)
ENV NIX_REMOTE=daemon

USER root

# Allow git operations on bind-mounted workspaces owned by a different UID.
# Required for `nix develop .` (libgit2) when the workspace UID does not match
# the container process UID. Mirrors Dockerfile.nix-daemon.
RUN git config --system safe.directory "*"

# Ensure /usr/local/bin is in PATH (defensive for custom base images)
ENV PATH="/usr/local/bin:${PATH}"

ARG USERNAME=user
ARG UID=1000
ARG GID=1000
ARG EXTRA_DIRS=""

# Create user and the union of all agent config directories (idempotent - safe
# even if the user/dirs already exist). The union covers every supported
# harness so a single image serves all of them.
RUN set -e; \
    if getent group ${GID} >/dev/null 2>&1; then \
        GROUP_NAME=$(getent group ${GID} | cut -d: -f1); \
    else \
        groupadd -g ${GID} --non-unique ${USERNAME} 2>/dev/null || true; \
        GROUP_NAME=${USERNAME}; \
    fi && \
    if ! getent passwd ${USERNAME} >/dev/null 2>&1; then \
        useradd -u ${UID} -g ${GID} -m -d /home/${USERNAME} --non-unique -s /bin/bash ${USERNAME} 2>/dev/null || true; \
    fi && \
    mkdir -p /home/${USERNAME} && \
    mkdir -p /workspace \
             /home/${USERNAME}/.cache \
             /home/${USERNAME}/.claude \
             /home/${USERNAME}/.pi \
             /home/${USERNAME}/.config \
             /home/${USERNAME}/.agents \
             /home/${USERNAME}/.local \
             ${EXTRA_DIRS} && \
    chown -R ${UID}:${GID} /workspace \
                           /home/${USERNAME}/.cache \
                           /home/${USERNAME}/.claude \
                           /home/${USERNAME}/.pi \
                           /home/${USERNAME}/.config \
                           /home/${USERNAME}/.agents \
                           /home/${USERNAME}/.local \
                           /home/${USERNAME} \
                           ${EXTRA_DIRS} 2>/dev/null || true

USER ${USERNAME}
WORKDIR /workspace

CMD ["bash"]
