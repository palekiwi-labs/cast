# Template: cast renders the configured Nix version into the base
# image reference before handing this Dockerfile to a build.
FROM nixos/nix:${NIX_VERSION}

# Allow building git repositories owned by different users
# This is necessary because the daemon builds repos on behalf of multiple dev containers
RUN git config --global safe.directory "*"

VOLUME /nix

ENV GC_NPROCS=1

CMD ["nix-daemon"]
